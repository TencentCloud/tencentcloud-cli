    "Credentials": {
      "document": "临时证书",
      "members": [
        {
          "disabled": false,
          "document": "token。token长度和绑定的策略有关，最长不超过4096字节。",
          "example": "da1e***",
          "member": "string",
          "name": "Token",
          "output_required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "临时证书密钥ID。最长不超过1024字节。",
          "example": "AKID***",
