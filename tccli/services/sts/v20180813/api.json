          "name": "RoleArn",
          "required": true,
          "type": "string"
        },
        {
          "disabled": false,
          "document": "会话名称",
          "example": "readOnlySession",
          "member": "string",
          "name": "RoleSessionName",
          "required": true,
          "type": "string"
        },
        {
          "disabled": false,
          "document": "指定临时访问凭证的有效期，单位：秒，默认 7200 秒，最长可设定有效期为 43200 秒",
