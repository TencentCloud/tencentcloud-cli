{
  "actions": {
    "CheckUserResource": {
      "document": "接口用于控制台用户开通权限时，前端提前检查用户是否已经开通，如果已开通则按钮不可点击",
      "input": "CheckUserResourceRequest",
      "name": "检查用户资源（控制台开通场景）",
      "output": "CheckUserResourceResponse",
      "status": "online"
    },
    "SearchByText": {
      "document": "文搜图接口，以JSON形式向客户提供搜索结果数据，包含标题、宽高、缩略图、内容来源url等信息",
      "input": "SearchByTextRequest",
      "name": "文搜图",
      "output": "SearchByTextResponse",
      "status": "online"
    }
  },
  "metadata": {
    "apiVersion": "2025-11-06",
    "api_brief": "用户输入文本描述，模型通过计算文本向量与图像向量的相似度，精准匹配并返回相关图片URL等信息。",
    "serviceNameCN": "联网图像搜索",
    "serviceShortName": "wimgs"
  },
  "objects": {
