    "QueryInsuranceRisk": {
      "document": "天御保险反欺诈评分服务，保险反欺诈是一款专门针对保险行业客户的反欺诈产品，通过腾讯的智慧风控能力，可以准确识别恶意用户与行为，帮助客户解决在投保、签约、理赔等业务环节遇到的欺诈威胁，降低企业的损失。",
      "input": "QueryInsuranceRiskRequest",
      "name": "天御保险反欺诈",
      "output": "QueryInsuranceRiskResponse",
      "status": "online"
    }
  },
