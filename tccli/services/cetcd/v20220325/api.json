{
  "actions": {
    "DeleteEtcdInstance": {
      "document": "删除etcd实例",
      "input": "DeleteEtcdInstanceRequest",
      "name": "删除etcd实例",
      "output": "DeleteEtcdInstanceResponse",
      "status": "online"
    },
    "DescribeEtcdInstances": {
      "document": "查询etcd实例列表",
      "input": "DescribeEtcdInstancesRequest",
      "name": "查询etcd实例列表",
      "output": "DescribeEtcdInstancesResponse",
      "status": "online"
    }
  },
  "metadata": {
    "apiVersion": "2022-03-25",
    "api_brief": "介绍如何使用API对etcd服务进行操作，包括创建etcd实例，创建备份以及恢复备份等。",
    "serviceNameCN": "云原生 ETCD",
    "serviceShortName": "cetcd"
  },
  "objects": {
    "DeleteEtcdInstanceRequest": {
      "document": "DeleteEtcdInstance请求参数结构体",
      "members": [
        {
          "document": "etcd实例id",
          "example": "etcd-abcd1234",
          "member": "string",
          "name": "InstanceId",
          "required": true,
          "type": "string"
        }
      ],
      "type": "object"
    },
    "DeleteEtcdInstanceResponse": {
      "document": "DeleteEtcdInstance返回参数结构体",
      "members": [
        {
          "document": "唯一请求 ID，每次请求都会返回。定位问题时需要提供该次请求的 RequestId。",
          "member": "string",
          "name": "RequestId",
          "type": "string"
        }
      ],
      "type": "object"
    },
    "DescribeEtcdInstancesRequest": {
      "document": "DescribeEtcdInstances请求参数结构体",
      "members": [
        {
          "document": "按照一个或者多个实例ID查询。实例ID形如：etcd-xxxxxxxx。参数不支持同时指定InstanceIds和Filters",
          "example": "[\"etcd-abcd1234\"]",
          "member": "string",
          "name": "InstanceIds",
          "required": false,
          "type": "list"
        },
        {
          "document": "支持按照vpc-id和instance-id过滤。参数不支持同时指定InstanceIds和Filters",
          "example": "无",
          "member": "Filter",
          "name": "Filters",
          "required": false,
          "type": "list"
        },
        {
          "document": "偏移量，默认为0",
          "example": "0",
          "member": "uint64",
          "name": "Offset",
          "required": false,
          "type": "int"
        },
        {
          "document": "返回数量，默认为20，最大值为100",
          "example": "0",
          "member": "uint64",
          "name": "Limit",
          "required": false,
          "type": "int"
        }
      ],
      "type": "object"
    },
    "DescribeEtcdInstancesResponse": {
      "document": "DescribeEtcdInstances返回参数结构体",
      "members": [
        {
          "document": "etcd实例详细信息列表\n注意：此字段可能返回 null，表示取不到有效值。",
          "example": "无",
          "member": "Etcd",
          "name": "Etcds",
          "required": true,
          "type": "list",
          "value_allowed_null": true
        },
        {
          "document": "符合条件的实例数量",
          "example": "10",
          "member": "uint64",
          "name": "TotalCount",
          "required": true,
          "type": "int",
          "value_allowed_null": false
        },
        {
          "document": "唯一请求 ID，每次请求都会返回。定位问题时需要提供该次请求的 RequestId。",
          "member": "string",
          "name": "RequestId",
          "type": "string"
        }
      ],
      "type": "object"
    },
    "Etcd": {
      "document": "etcd信息",
      "members": [
        {
          "document": "实例id",
          "example": "etcd-ctq51lvf",
          "member": "string",
          "name": "InstanceId",
          "required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "document": "实例名",
          "example": "test",
          "member": "string",
          "name": "Name",
          "required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "document": "实例描述\n注意：此字段可能返回 null，表示取不到有效值。",
          "example": "\"\"",
          "member": "string",
          "name": "Description",
          "required": true,
          "type": "string",
          "value_allowed_null": true
        },
        {
          "document": "实例所属vpcId",
          "example": "vpc-35lahm68",
          "member": "string",
          "name": "VpcId",
          "required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "document": "etcd版本",
          "example": "v3.5.0",
          "member": "string",
          "name": "Version",
          "required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "document": "实例状态",
          "example": "running",
          "member": "string",
          "name": "Status",
          "required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "document": "etcd成员信息\n注意：此字段可能返回 null，表示取不到有效值。",
          "example": "无",
          "member": "EtcdMember",
          "name": "Members",
          "required": true,
          "type": "list",
          "value_allowed_null": true
        },
        {
          "document": "对外访问地址\n注意：此字段可能返回 null，表示取不到有效值。",
          "example": "https://10.0.1.127:1234",
          "member": "string",
          "name": "Endpoint",
          "required": true,
          "type": "string",
          "value_allowed_null": true
        }
      ],
      "usage": "out"
    },
    "EtcdMember": {
      "document": "etcd集群成员信息",
      "members": [
        {
          "document": "节点名字",
          "example": "etcd-6app8i2u-etcd-0",
          "member": "string",
          "name": "Name",
          "required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "document": "节点当前版本",
          "example": "v3.4.13.tke.2",
          "member": "string",
          "name": "Version",
          "required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "document": "所属可用区",
          "example": "ap-chongqing-1",
          "member": "string",
          "name": "Zone",
          "required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "document": "节点状态",
          "example": "Running",
          "member": "string",
          "name": "Status",
          "required": true,
          "type": "string",
          "value_allowed_null": false
        }
      ],
      "usage": "out"
    },
    "Filter": {
      "document": "过滤器",
      "members": [
        {
          "document": "属性名称, 若存在多个Filter时，Filter间的关系为逻辑与（AND）关系。",
          "example": "instance-id",
          "member": "string",
          "name": "Name",
          "required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "document": "属性值, 若同一个Filter存在多个Values，同一Filter下Values间的关系为逻辑或（OR）关系。",
          "example": "[\"abc\"]",
          "member": "string",
          "name": "Values",
          "required": true,
          "type": "list",
          "value_allowed_null": false
        }
      ],
      "usage": "in"
    }
  },
  "version": "1.0"
}