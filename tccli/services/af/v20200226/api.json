    "AntiFraudRecord": {
      "document": "反欺诈查询结果",
      "members": [
        {
          "disabled": false,
          "document": "公共错误码",
          "example": "0",
          "member": "string",
          "name": "Code",
          "output_required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "业务侧错误码。",
          "example": "Success",
          "member": "string",
          "name": "CodeDesc",
          "output_required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "业务侧错误信息。",
          "example": "Success",
          "member": "string",
          "name": "Message",
          "output_required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "表示该条记录能否查到：1 为能查到；-1 为查不到，此时 RiskScore 返回-1；",
          "example": "1",
          "member": "string",
          "name": "Found",
          "output_required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "表示该条记录中的身份 ID 能否查到\n1 为能查到\n-1 为查不到",
          "example": "-1",
          "member": "string",
          "name": "IdFound",
          "output_required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "当可查到时，返回 0~100 区间，值越高 欺诈可\n能性越大。\n当查不到时（即 found=-1），返回-1",
          "example": "80",
          "member": "string",
          "name": "RiskScore",
          "output_required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "扩展字段，对风险类型的说明。扩展字段并非必\n然出现。",
          "example": "无",
          "member": "SimpleKindRiskDetail",
          "name": "RiskInfo",
          "output_required": true,
          "type": "list",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "默认出现，提供模型版本号说明及多模型返回需\n要时用到；",
          "example": "无",
          "member": "OtherModelScoresDetail",
          "name": "OtherModelScores",
          "output_required": true,
          "type": "list",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "表示请求时间，标准 sunix 时间戳，非必然出现",
          "example": "1741231013",
          "member": "string",
          "name": "PostTime",
          "output_required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "拓展字段，非必然出现，和 ExtensionIn 对应；\n注：非必然出现，需要返回时天御侧将说明；",
          "example": "无",
          "member": "string",
          "name": "ExtensionOut",
          "output_required": true,
          "type": "string",
          "value_allowed_null": false
        }
      ],
      "usage": "out"
    },
