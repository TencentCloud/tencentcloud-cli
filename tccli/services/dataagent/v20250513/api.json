          "example": "1",
          "member": "int64",
          "name": "InsertPos",
          "required": false,
          "type": "int"
        },
        {
          "disabled": false,
          "document": "chunk内容",
          "example": "test",
          "member": "string",
          "name": "Content",
          "required": false,
          "type": "string"
        },
        {
          "disabled": false,
          "document": "\t 新 Chunk 插入到目标 Chunk ​之后的位置。插入位置的上一个 chunkId",
          "example": "xzcjjjij",
          "member": "string",
          "name": "AfterChunkId",
          "required": false,
          "type": "string"
        }
      ],
      "type": "object"
    },
    "AddChunkResponse": {
      "document": "AddChunk返回参数结构体",
