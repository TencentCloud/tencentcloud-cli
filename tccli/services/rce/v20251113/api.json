    "Customer": {
      "document": "腾讯云客户信息",
      "members": [
        {
          "disabled": false,
          "document": "客户的腾讯云主账号的app id。",
          "example": "256***201",
          "member": "string",
          "name": "AppId",
          "required": true,
          "type": "string"
        },
        {
          "disabled": false,
          "document": "客户的腾讯云主账号uin。",
          "example": "1000***5481",
          "member": "string",
          "name": "Uin",
          "required": true,
          "type": "string"
        },
        {
          "disabled": false,
          "document": "客户的腾讯云子账号subuin。若无子账号，该字段请填入uin信息。",
          "example": "1000***5481",
          "member": "string",
          "name": "SubUin",
          "required": true,
          "type": "string"
        },
        {
          "disabled": false,
          "document": "客户ID。当客户为渠道路径，可填充您系统中维护的客户ID。",
          "example": "7100***6325",
          "member": "string",
          "name": "Id",
          "required": false,
          "type": "string"
        },
        {
          "disabled": false,
          "document": "客户名称。当客户为渠道路径，可填充您系统中维护的客户名称。",
          "example": "腾讯**公司",
          "member": "string",
          "name": "Name",
          "required": false,
          "type": "string"
        },
        {
          "disabled": false,
          "document": "客户所属行业。枚举值：\n- internet-泛互联网，\n- finance-金融，\n- health-医疗，\n- transportation-交通与物流，\n- education-教育，\n- retail-零售与消费，\n- energy-能源与工业，\n- mobility-汽车与出行，\n- agriculture-农业与食品，\n- government-政务与公共服务，\n- culture-文旅，\n- other-其他。",
          "example": "internet",
          "member": "string",
          "name": "Industry",
          "required": false,
          "type": "string"
        }
      ],
      "usage": "in"
    },
