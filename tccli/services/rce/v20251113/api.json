  "metadata": {
    "apiVersion": "2025-11-13",
    "api_brief": "完善的服务体系\n快速部署服务体系，前期专业的恶意诊断，提供最优安全策略，后期重大活动专人跟进，全面分析实时数据报表。\n\n腾讯同款安全服务\n天御防刷服务已为腾讯多款产品和业务提供完善的账号保护体系，经历了数亿用户十年的考验。",
    "serviceNameCN": "风险识别 RCE",
    "serviceShortName": "rce"
  },
