{
  "actions": {
    "DescribeCacheTask": {
      "document": "该接口（DescribeCacheTask）可根据指定条件实时查询刷新/预热的任务状态。",
      "input": "DescribeCacheTaskRequest",
      "name": "查询刷新预热任务状态",
      "output": "DescribeCacheTaskResponse",
      "status": "online"
    },
    "DescribeDomains": {
      "document": "该接口（DescribeDomains）可按条件查询本账号下HCDN的域名列表。",
      "input": "DescribeDomainsRequest",
      "name": "查询域名列表",
      "output": "DescribeDomainsResponse",
      "status": "online"
    },
    "PreloadCache": {
      "document": "本接口（PreloadCache）用于提交URL预热任务，HCDN节点将URL资源提前缓存。",
      "input": "PreloadCacheRequest",
      "name": "预热资源",
      "output": "PreloadCacheResponse",
      "status": "online"
    },
    "RefreshCache": {
      "document": "本接口（RefreshCache）用于提交URL刷新任务，HCDN节点将该URL对应的资源缓存清除，任务执行结果可通过接口（DescribeCacheTask）查询。",
      "input": "RefreshCacheRequest",
      "name": "刷新资源",
      "output": "RefreshCacheResponse",
      "status": "online"
    }
  },
  "metadata": {
    "apiVersion": "2022-09-27",
    "api_brief": "介绍如何使用混合分发加速API接口，实现数据查询、刷新预热等操作",
    "serviceNameCN": "混合分发加速",
    "serviceShortName": "hcdn"
  },
