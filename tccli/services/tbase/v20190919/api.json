{
  "actions": {
    "DescribeAvailableRecoveryTime": {
      "document": "数据恢复时，获取回档时间",
      "input": "DescribeAvailableRecoveryTimeRequest",
      "name": "获取回档时间",
      "output": "DescribeAvailableRecoveryTimeResponse",
      "status": "online"
    },
    "DescribeBackupSpace": {
      "document": "获取备份容量的实时数据，对应备份实时统计页面",
      "input": "DescribeBackupSpaceRequest",
      "name": "获取备份容量的实时数据",
      "output": "DescribeBackupSpaceResponse",
      "status": "online"
    },
    "DescribeBaseBackups": {
      "document": "本接口 (DescribeBaseBackups) 用于查询该用户名下实例的数据备份空间。",
      "input": "DescribeBaseBackupsRequest",
      "name": "查询数据备份",
      "output": "DescribeBaseBackupsResponse",
      "status": "online"
    },
    "DescribeDBTables": {
      "document": "本接口（DescribeDBTable）用于查询数据库下的schema下的所有表名称。",
      "input": "DescribeDBTablesRequest",
      "name": "查询Schema下的所有表名称",
      "output": "DescribeDBTablesResponse",
      "status": "online"
    },
    "DescribeUserTasks": {
      "document": "本接口 (DescribeUserTasks) 用于查询任务列表和详情。",
      "input": "DescribeUserTasksRequest",
      "name": "查询任务列表",
      "output": "DescribeUserTasksResponse",
      "status": "online"
    }
  },
