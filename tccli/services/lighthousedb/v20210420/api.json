      "name": "创建集群",
      "output": "CreateClustersResponse",
      "status": "online"
    },
    "DescribeRenewResourceParams": {
      "document": "获取续费集群入参",
      "input": "DescribeRenewResourceParamsRequest",
      "name": "获取续费集群入参",
      "output": "DescribeRenewResourceParamsResponse",
      "status": "online"
    },
    "OffLineCluster": {
      "document": "下线集群",
      "input": "OffLineClusterRequest",
      "name": "下线集群",
      "output": "OffLineClusterResponse",
      "status": "online"
    },
