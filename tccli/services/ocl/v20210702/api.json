        {
          "disabled": false,
          "document": "课堂类型 1、1v1     2、1vn   3、直播课    4、转码     5、存储",
          "example": "1",
          "member": "int64",
          "name": "ClassType",
          "required": true,
          "type": "int",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "used  消费量（单位对齐  课时 分钟   转码 分钟  存储 mb）",
