          "member": "float",
          "name": "Used",
          "required": true,
          "type": "float",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "清晰度/计费项 1：1v1-320   2:1v1-640  3:1v1-720  4:1vn-320  5:1vn-640                                  \t\t     6:1vn-720   7:直播课540   8 直播课720   9 直播课1080 10：转码 11：存储",
          "example": "1",
          "member": "int64",
          "name": "SubType",
          "required": true,
          "type": "int",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "消费类型 1、课时费 2、转码  3存储",
          "example": "1",
          "member": "int64",
          "name": "UsedType",
          "required": true,
          "type": "int",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "1:预付费  2:后付费  3：转码 4:存储",
          "example": "1",
          "member": "int64",
          "name": "CostType",
          "required": true,
          "type": "int",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "时间",
          "example": "2021-04-20 08:08:08",
          "member": "string",
          "name": "CreateTime",
          "required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "K+0000+课堂ID",
          "example": "K0000102301225",
          "member": "string",
          "name": "DealName",
          "required": true,
          "type": "string",
          "value_allowed_null": false
        }
      ],
      "usage": "out"
    },
