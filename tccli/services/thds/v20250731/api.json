    "FHIRInstanceConfig": {
      "document": "FHIR实例配置参数",
      "members": [
        {
          "disabled": false,
          "document": "FHIR版本",
          "example": "R4",
          "member": "string",
          "name": "FHIRVersion",
          "output_required": false,
          "required": false,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "客户端 ID 策略，取值范围为ANY，ALPHANUMERIC，NOT_ALLOWED。NOT_ALLOWED则不允许客户端 设置 ID，ANY 则表示允许，ALPHANUMERIC 表示字母与数字组合（不允许纯数字）",
          "example": "ANY",
          "member": "string",
          "name": "ClientIDStrategy",
          "output_required": false,
          "required": false,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "服务端 ID 策略，取值范围为UUID(默认)，SEQUENTIAL_NUMERIC。UUID 表示使用uuid作为服务端 ID，SEQUENTIAL_NUMERIC 表示使用自增序列作为服务端 ID。",
          "example": "UUID",
          "member": "string",
          "name": "ServerIDStrategy",
          "output_required": false,
          "required": false,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "是否开启资源版本管理",
          "example": "true",
          "member": "bool",
          "name": "ResourceDBHistoryEnabled",
          "output_required": false,
          "required": false,
          "type": "bool",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "是否开启严格模式。严格模式下，搜索时，如果搜索条件不合法，则会返回错误。",
          "example": "false",
          "member": "bool",
          "name": "SearchStrictModeEnabled",
          "output_required": false,
          "required": false,
          "type": "bool",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "是否强制开启引用完整性",
          "example": "false",
          "member": "bool",
          "name": "EnforceReferentialIntegrity",
          "output_required": false,
          "required": false,
          "type": "bool",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "复杂类型引用校验策略，取值范围 IGNORE，CHECK_TYPE_IF_EXISTS，CHECK_EXISTS，CHECK_EXISTS_AND_TYPE，CHECK_VALID。IGNORE：不校验，CHECK_TYPE_IF_EXISTS：如果存在，则校验类型，CHECK_EXISTS：如果存在，则校验，CHECK_EXISTS_AND_TYPE：如果存在，则校验类型，CHECK_VALID：校验。",
          "example": "IGNORE",
          "member": "string",
          "name": "ComplexTypeReferenceValidationPolicy",
          "output_required": false,
          "required": false,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "是否开启校验",
          "example": "false",
          "member": "bool",
          "name": "RepositoryValidationEnabled",
          "output_required": false,
          "required": false,
          "type": "bool",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "是否强制引用类型校验",
          "example": "true",
          "member": "bool",
          "name": "EnforceReferenceTargetTypes",
          "output_required": false,
          "required": false,
          "type": "bool",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "是否开启基于Consent的访问控制",
