{
  "actions": {
    "DescribeCluster": {
      "document": "查询可用区的cuf信息列表",
      "input": "DescribeClusterRequest",
      "name": "查询可用区的cuf信息列表",
      "output": "DescribeClusterResponse",
      "status": "online"
    },
    "DescribeProducts": {
      "document": "本接口(DescribeProducts)用于查询各个支持地域列表查询的产品信息。",
      "input": "DescribeProductsRequest",
      "name": "查询支持地域列表查询的产品",
      "output": "DescribeProductsResponse",
      "status": "online"
    },
    "DescribeRegions": {
      "document": "本接口(DescribeRegions)用于查询各个产品支持地域信息。",
      "input": "DescribeRegionsRequest",
      "name": "查询产品支持的地域列表",
      "output": "DescribeRegionsResponse",
      "status": "online"
    },
    "DescribeRegionsAndZones": {
      "document": "地域管理向前端提供查询地域和可用区列表",
      "input": "DescribeRegionsAndZonesRequest",
      "name": "查询地域和可用区列表",
      "output": "DescribeRegionsAndZonesResponse",
      "status": "online"
    },
    "DescribeZones": {
      "document": "本接口(DescribeZones)用于查询产品可用区信息。",
      "input": "DescribeZonesRequest",
      "name": "查询产品可用区列表",
      "output": "DescribeZonesResponse",
      "status": "online"
    }
  },
  "metadata": {
