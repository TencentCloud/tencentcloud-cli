          "document": "课程学习可见范围属性，0：公开 1：班级内\t2：组织内 3：授权列表内",
          "example": "0",
          "member": "int64",
          "name": "VisibleScope",
          "required": true,
          "type": "int"
        },
        {
          "disabled": false,
          "document": "课程名",
          "example": "测试课程",
          "member": "string",
