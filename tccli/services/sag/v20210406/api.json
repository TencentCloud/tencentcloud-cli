  "metadata": {
    "apiVersion": "2021-04-06",
    "api_brief": "腾讯应用级智能网关（Smart Application Gateway，SAG）是一款稳定、安全、高性能、易用的应用级智能网关，让用户更高效快捷的访问企业应用和服务。本产品基于零信任策略，对企业应用和服务提供集中管控，统一防控和统一审计，保障企业应用和服务更安全、更可靠。",
    "serviceNameCN": "应用级智能网关",
    "serviceShortName": "sag"
  },
