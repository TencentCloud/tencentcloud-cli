    "CreateDataRepositoryTaskRequest": {
      "document": "CreateDataRepositoryTask请求参数结构体",
      "members": [
        {
          "disabled": false,
          "document": "数据流通任务类型, FS_TO_COS(文件系统到COS Bucket),或者COS_TO_FS(COS Bucket到文件系统)",
          "example": "FS_TO_BUCKET",
          "member": "string",
          "name": "TaskType",
          "required": true,
          "type": "string",
          "visibility": 1
        },
        {
          "disabled": false,
          "document": "COS存储桶名",
          "example": "mybucket-1250000",
          "member": "string",
          "name": "Bucket",
          "required": true,
          "type": "string",
          "visibility": 1
        },
        {
          "disabled": false,
          "document": "文件系统ID",
          "example": "x_c60_r3c4fa1f",
          "member": "string",
          "name": "FileSystemId",
          "required": true,
          "type": "string",
          "visibility": 1
        },
        {
          "disabled": false,
          "document": "对于FS_TO_COS, TaskPath是Bucket映射目录的相对路径, 对于COS_TO_FS是COS上的路径。如果置为空, 则表示全部数据",
          "example": "aaa/bbb",
          "member": "string",
          "name": "TaskPath",
          "required": true,
          "type": "string",
          "visibility": 1
        },
        {
          "disabled": false,
          "document": "任务名称",
          "example": "mydownload",
          "member": "string",
          "name": "TaskName",
          "required": true,
          "type": "string",
          "visibility": 1
        },
        {
          "disabled": false,
          "document": "数据流通方式 MSP_AFM 手动加载  RAW_AFM 按需加载",
          "example": "MSP_AFM",
          "member": "string",
          "name": "RepositoryType",
          "required": false,
          "type": "string",
          "visibility": 1
        },
        {
          "disabled": false,
          "document": "文件列表下载地址，以http开头",
          "example": "https://location.com/list.txt",
          "member": "string",
          "name": "TextLocation",
          "required": false,
          "type": "string",
          "visibility": 1
        }
      ],
      "type": "object"
    },
