          "member": "string",
          "name": "RuleId",
          "required": false,
          "type": "string",
          "value_allowed_null": true,
          "visibility": 1
        },
        {
          "disabled": false,
          "document": "规则备注与描述\n注意：此字段可能返回 null，表示取不到有效值。",
