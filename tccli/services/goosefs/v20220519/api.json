    "MappedBucket": {
      "document": "关联的对象Bucket, 并将其映射到文件系统某个路径上",
      "members": [
        {
          "disabled": false,
          "document": "对象存储Bucket名",
          "example": "mybucket-1250000",
          "member": "string",
          "name": "BucketName",
          "required": true,
