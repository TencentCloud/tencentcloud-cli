{
  "actions": {
    "AddCommonComment": {
      "document": "供第三方接口调用的添加评论",
      "input": "AddCommonCommentRequest",
      "name": "添加评论通用接口",
      "output": "AddCommonCommentResponse",
      "status": "online"
    },
    "AppraiseTicket": {
      "document": "用户评价工单",
      "input": "AppraiseTicketRequest",
      "name": "用户评价工单",
      "output": "AppraiseTicketResponse",
      "status": "online"
    },
    "AssignIncidentManager": {
      "document": "工单事件经理派单接口，根据具体业务场景，分派工单事件经理并通知",
      "input": "AssignIncidentManagerRequest",
      "name": "工单事件经理派单",
      "output": "AssignIncidentManagerResponse",
      "status": "online"
    },
    "BatchGetTicketStatus": {
      "document": "批量获取工单状态",
      "input": "BatchGetTicketStatusRequest",
      "name": "批量获取工单状态",
      "output": "BatchGetTicketStatusResponse",
      "status": "online"
    },
    "CloseCommonTicket": {
      "document": "提供给第三方调用的关闭工单，当工单状态为 未处理 时, 可调用 CloseCommonTicket 对工单进行撤销, 当工单进入处理中后, 不能直接关闭工单, 需工单状态转为 待确认 后, 可调用 CloseCommonTicket 接口关单, 此时, 需传入满意度(1-5), 以及评价内容",
      "input": "CloseCommonTicketRequest",
      "name": "关闭工单通用接口",
      "output": "CloseCommonTicketResponse",
      "status": "online"
    },
    "CloseTicket": {
      "document": "用户结单或者撤单接口",
      "input": "CloseTicketRequest",
      "name": "用户结单或者撤单",
      "output": "CloseTicketResponse",
      "status": "online"
    },
    "CreateCommonTicket": {
      "document": "提供给第三方调用的创建工单",
      "input": "CreateCommonTicketRequest",
      "name": "创建工单通用接口",
      "output": "CreateCommonTicketResponse",
      "status": "online"
    },
    "CreateInternalTicket": {
      "document": "提供给内部通道建单",
      "input": "CreateInternalTicketRequest",
      "name": "创建内部通道工单",
      "output": "CreateInternalTicketResponse",
      "status": "online"
    },
    "GetAppraisalOptions": {
      "document": "获取评价选项",
      "input": "GetAppraisalOptionsRequest",
      "name": "获取评价选项",
      "output": "GetAppraisalOptionsResponse",
      "status": "online"
    },
    "GetCommonCategoryList": {
      "document": "供第三获取官网分类",
      "input": "GetCommonCategoryListRequest",
      "name": "第三方获取官网分类信息",
      "output": "GetCommonCategoryListResponse",
      "status": "online"
    },
    "GetCommonCategoryListById": {
      "document": "第三方通过二级分类Id获取三级分类",
      "input": "GetCommonCategoryListByIdRequest",
      "name": "第三方获取子分类信息",
      "output": "GetCommonCategoryListByIdResponse",
      "status": "online"
    },
    "GetCommonTicketDetail": {
      "document": "供第三方接口获取工单详情",
      "input": "GetCommonTicketDetailRequest",
      "name": "获取工单详情通用接口",
      "output": "GetCommonTicketDetailResponse",
      "status": "online"
    },
    "GetCommonTicketList": {
      "document": "供第三方接口获取工单列表",
