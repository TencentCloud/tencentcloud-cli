      "name": "获取工单列表通用接口",
      "output": "GetCommonTicketListResponse",
      "status": "online"
    },
    "GetCosKeysAndPrefix": {
      "document": "获取cos临时密钥和前缀",
      "input": "GetCosKeysAndPrefixRequest",
      "name": "获取cos临时密钥和前缀",
      "output": "GetCosKeysAndPrefixResponse",
      "status": "online"
    },
    "GetInternalServiceScene": {
      "document": "供内部建单选择工单归档",
      "input": "GetInternalServiceSceneRequest",
      "name": "获取内部通道工单归档",
      "output": "GetInternalServiceSceneResponse",
      "status": "online"
    },
    "GetInternalTicket": {
      "document": "内部通道工单详情",
      "input": "GetInternalTicketRequest",
      "name": "获取工单详情",
      "output": "GetInternalTicketResponse",
      "status": "online"
    },
    "GetOpenTicketInfo": {
      "document": "获取工单状态，当前处理人，优先级，工单归档，工单处理耗时，结单信息，评价信息，外部回复流水等工单相关信息",
      "input": "GetOpenTicketInfoRequest",
      "name": "获取工单信息(内部调用)",
      "output": "GetOpenTicketInfoResponse",
      "status": "online"
    },
    "GetTicketOperation": {
