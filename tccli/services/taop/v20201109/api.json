          "member": "string",
          "name": "Fields",
          "required": false,
          "type": "list"
        },
        {
          "disabled": false,
          "document": "查询条件",
          "example": "[{\"Field\":\"Role\",\"Opt\":5,\"Value\":\"1,2,4\"}]",
