{
  "actions": {
    "DescribeInstanceHostInfo": {
      "document": "获取实例ID所在的裸金属实例所在的物理机信息",
      "input": "DescribeInstanceHostInfoRequest",
      "name": "获取裸金属实例信息",
      "output": "DescribeInstanceHostInfoResponse",
      "status": "online"
    },
    "DescribeInstances": {
      "document": "本接口 (DescribeInstances) 用于查询一个或多个实例的详细信息。\n\n- 可以根据实例ID、vpcid或者实例私有IP等信息来查询实例的详细信息。过滤信息详细请见过滤器Filter。\n- 如果参数为空，返回当前用户一定数量（Limit所指定的数量，默认为20）的实例。",
      "input": "DescribeInstancesRequest",
      "name": "查看实例列表",
      "output": "DescribeInstancesResponse",
      "status": "online"
    },
    "DescribeZoneInstanceTypeInventory": {
      "document": "获取可用区的机型信息",
      "input": "DescribeZoneInstanceTypeInventoryRequest",
      "name": "查询资源库存情况",
      "output": "DescribeZoneInstanceTypeInventoryResponse",
      "status": "online"
    },
    "RunInstances": {
      "document": "创建实例接口 与云API RunInstances接口相似，可参考RunInstances",
      "input": "RunInstancesRequest",
      "name": "创建实例",
      "output": "RunInstancesResponse",
      "status": "online"
    },
    "RunProxyCall": {
      "document": "cube通过云api提供一个“公司内部”的通用代理接口，实现在公有云vpc环境实现网络访问。",
      "input": "RunProxyCallRequest",
      "name": "通用代理访问云支撑环境接口",
      "output": "RunProxyCallResponse",
      "status": "online"
    },
    "TerminateInstances": {
      "document": "- 不再使用的实例，可通过本接口主动退还\n- 本接口通过异步逻辑实现销毁，销毁成功后会异步通知客户端",
      "input": "TerminateInstancesRequest",
      "name": "销毁实例",
      "output": "TerminateInstancesResponse",
      "status": "online"
    }
  },
  "metadata": {
