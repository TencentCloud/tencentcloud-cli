          "document": "应用窗口类名",
          "example": "\"application class\"",
          "member": "string",
          "name": "WindowClassName",
          "output_required": true,
          "required": false,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "应用窗口捕捉模式",
          "example": "\"HOOK|DDA_CUT\"",
