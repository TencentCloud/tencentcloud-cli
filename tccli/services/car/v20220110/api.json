          "member": "string",
          "name": "WindowUseType",
          "output_required": true,
          "required": true,
          "type": "string",
          "value_allowed_null": false
        },
        {
          "disabled": false,
          "document": "应用窗口名称",
          "example": "\"application test\"",
          "member": "string",
          "name": "WindowName",
          "output_required": true,
          "required": false,
          "type": "string",
          "value_allowed_null": false
