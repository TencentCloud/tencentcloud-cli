  "metadata": {
    "apiVersion": "2021-05-18",
    "api_brief": "智能导诊服务，是腾讯基于医疗AI、自然语言处理技术，推出的以智能导诊为核心，包含智能问病、智能问药、医务咨询等十多种就医服务能力的AI产品，可应用于微信线上挂号、互联网医院、区域平台等场景中，解决了由于患者医药专业知识缺乏，院内咨询不便导致的医患资源错配的痛点，同时满足智慧医院服务评级的诉求。",
    "serviceNameCN": "智能导诊",
    "serviceShortName": "ig"
  },
