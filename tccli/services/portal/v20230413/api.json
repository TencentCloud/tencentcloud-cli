{
  "actions": {
    "CorrectText": {
      "document": "提供文本纠错能力，可以进行错别字，单词拼写，标点符号，代码语法等常见的文本错误检查",
      "input": "CorrectTextRequest",
      "name": "文本纠错",
      "output": "CorrectTextResponse",
      "status": "online"
    },
    "GetCurrentPolicy": {
      "document": "获取纠错系统当前支持的具体策略",
      "input": "GetCurrentPolicyRequest",
      "name": "获取当前支持策略",
      "output": "GetCurrentPolicyResponse",
      "status": "online"
    },
    "SeparateText": {
      "document": "将比较长的文本按照一定规则切分成多个短文本",
      "input": "SeparateTextRequest",
      "name": "分割长文本",
      "output": "SeparateTextResponse",
      "status": "online"
    }
  },
  "metadata": {
    "apiVersion": "2023-04-13",
    "api_brief": "官网门户服务",
    "serviceNameCN": "官网",
    "serviceShortName": "portal"
  },
  "objects": {
    "CorrectTextRequest": {
      "document": "CorrectText请求参数结构体",
      "members": [
        {
          "disabled": false,
          "document": "需要进行纠错的文本，\n入参最大不超过64个unicode编码字符",
          "example": "接口返回检茶",
          "member": "string",
          "name": "Text",
          "required": true,
          "type": "string",
          "visibility": 2
        },
        {
          "disabled": false,
          "document": "当前文本需要采用的纠错策略。\n目前支持的纠错策略枚举值如下：\n[\n{\n  \"key\":\"symbols\",\n  \"value\":\"\",\n},\n{\n  \"key\":\"word\",\n  \"value\":\"\"\n},\n{\n  \"key\":\"sensitiveNumber\",\n  \"value\":\"gpt\" // 为空默认使用博通ai能力，传递gpt使用gpt ai能力检测\n},\n{\n  \"key\":\"zhErrCharacters\",\n  \"value\":\"\"\n},\n{\n  \"key\":\"link\",\n  \"value\":\"\"\n},\n{\n  \"key\":\"code\",\n  \"value\":\"go\" // 需要检测的编程语言，目前仅支持go,php\n},\n{\n  \"key\":\"blackList\",\n  \"value\":\"阿里云,百度云\"//需要找出的黑名单词汇，使用英文逗号隔开\n},\n]\n}\n]",
          "example": "[{\"key\":\"zhErrCharacters\",\"value\":\"gpt\"}]",
          "member": "ScanPolicy",
          "name": "ScanPolicy",
          "required": true,
          "type": "list",
          "visibility": 2
        }
      ],
      "type": "object"
    },
    "CorrectTextResponse": {
      "document": "CorrectText返回参数结构体",
      "members": [
        {
          "disabled": false,
          "document": "纠错接口返回的错误列表\n注意：此字段可能返回 null，表示取不到有效值。",
          "example": "[{\"offset\":5,\"len\":1,\"wrongSegment\":\"茶\",\"correct\":\"查\",\"type\":\"zhErrCharacters\",\"typeDesc\":\"错别字\"}]",
          "member": "WrongSegmentInfo",
          "name": "List",
          "type": "list",
          "value_allowed_null": true,
          "visibility": 2
        },
        {
          "document": "唯一请求 ID，每次请求都会返回。定位问题时需要提供该次请求的 RequestId。",
          "member": "string",
          "name": "RequestId",
          "type": "string"
        }
      ],
      "type": "object"
    },
    "GetCurrentPolicyRequest": {
      "document": "GetCurrentPolicy请求参数结构体",
      "members": [],
      "type": "object"
    },
    "GetCurrentPolicyResponse": {
      "document": "GetCurrentPolicy返回参数结构体",
      "members": [
        {
          "disabled": false,
          "document": "返回系统当前支持的策略信息，其中policy代表系统接受的策略值，Instruction代表对策略文解释，Pros代表策略执行所需的额外信息",
          "example": "{\"List\":[{\"Policy\":\"code\",\"Instruction\":\"代码\",\"Props\":\"php,go\"}]}",
          "member": "PolicyItem",
          "name": "List",
          "type": "list",
          "value_allowed_null": false,
          "visibility": 1
        },
        {
          "document": "唯一请求 ID，每次请求都会返回。定位问题时需要提供该次请求的 RequestId。",
          "member": "string",
          "name": "RequestId",
          "type": "string"
        }
      ],
      "type": "object"
    },
    "PolicyItem": {
      "document": "纠错系统当前支持策略单条信息结构",
      "members": [
        {
          "disabled": false,
          "document": "当前支持的策略值",
          "example": "code",
          "member": "string",
          "name": "Policy",
          "required": false,
          "type": "string",
          "value_allowed_null": false,
          "visibility": 2
        },
        {
          "disabled": false,
          "document": "对策略的中文解释",
          "example": "代码",
          "member": "string",
          "name": "Instruction",
          "required": false,
          "type": "string",
          "value_allowed_null": false,
          "visibility": 2
        },
        {
          "disabled": false,
          "document": "策略支持的额外信息\n注意：此字段可能返回 null，表示取不到有效值。",
          "example": "php,go",
          "member": "string",
          "name": "Props",
          "required": false,
          "type": "string",
          "value_allowed_null": true,
          "visibility": 2
        }
      ],
      "usage": "out"
    },
    "ScanPolicy": {
      "document": "纠错接口传入参数应用的具体策略",
      "members": [
        {
          "disabled": false,
          "document": "策略需要的额外信息，比如\nzhErrCharacters错别字检查同时支持chatgpt和botong两种方式检查，用户可根据自行需要选择采用",
          "example": "gpt",
          "member": "string",
          "name": "Value",
          "required": false,
          "type": "string",
          "value_allowed_null": true,
          "visibility": 1
        }
      ],
      "usage": "in"
    },
    "SegmentItem": {
      "document": "分段后文本的结构体信息",
      "members": [
        {
          "disabled": false,
          "document": "切分后片段在原文中的开始位置\n注意：此字段可能返回 null，表示取不到有效值。",
          "example": "1",
          "member": "uint64",
          "name": "Start",
          "required": false,
          "type": "int",
          "value_allowed_null": true,
          "visibility": 2
        },
        {
          "disabled": false,
          "document": "分割文本长度\n注意：此字段可能返回 null，表示取不到有效值。",
          "example": "15",
          "member": "uint64",
          "name": "Len",
          "required": false,
          "type": "int",
          "value_allowed_null": true,
          "visibility": 2
        },
        {
          "disabled": false,
          "document": "分割的文本内容\n注意：此字段可能返回 null，表示取不到有效值。",
          "example": "请输入待分割的长文本",
          "member": "string",
          "name": "Str",
          "required": false,
          "type": "string",
          "value_allowed_null": true,
          "visibility": 2
        }
      ],
      "usage": "out"
    },
    "SeparateTextRequest": {
      "document": "SeparateText请求参数结构体",
      "members": [
        {
          "disabled": false,
          "document": "需要分割的长文本",
          "example": "我是一个需要分割的长文本信息",
          "member": "string",
          "name": "Text",
          "required": true,
          "type": "string",
          "visibility": 2
        }
      ],
      "type": "object"
    },
    "SeparateTextResponse": {
      "document": "SeparateText返回参数结构体",
      "members": [
        {
          "disabled": false,
          "document": "分割后的文本列表\n注意：此字段可能返回 null，表示取不到有效值。",
          "example": "{\"List\":[{\"Start\":1,\"Len\":12,\"Str\":\"我是一个分割后的文本\"}]}",
          "member": "SegmentItem",
          "name": "List",
          "type": "list",
          "value_allowed_null": true,
          "visibility": 2
        },
        {
          "document": "唯一请求 ID，每次请求都会返回。定位问题时需要提供该次请求的 RequestId。",
          "member": "string",
          "name": "RequestId",
          "type": "string"
        }
      ],
      "type": "object"
    },
    "WrongSegmentInfo": {
      "document": "文本纠错接口返回的错误片段信息",
      "members": [
        {
          "disabled": false,
          "document": "错误开始位置",
          "example": "4",
          "member": "int64",
          "name": "Offset",
          "required": false,
          "type": "int",
          "value_allowed_null": false,
          "visibility": 2
        },
        {
          "disabled": false,
          "document": "错误片段长度\n注意：此字段可能返回 null，表示取不到有效值。",
          "example": "3",
          "member": "uint64",
          "name": "Len",
          "required": false,
          "type": "int",
          "value_allowed_null": true,
          "visibility": 2
        },
        {
          "disabled": false,
          "document": "错误内容",
          "example": "茶",
          "member": "string",
          "name": "WrongSegment",
          "required": false,
          "type": "string",
          "value_allowed_null": false,
          "visibility": 2
        },
        {
          "disabled": false,
          "document": "修改建议",
          "example": "查",
          "member": "string",
          "name": "Correct",
          "required": false,
          "type": "string",
          "value_allowed_null": false,
          "visibility": 2
        },
        {
          "disabled": false,
          "document": "触发的纠错策略",
          "example": "zhErrCharacters",
          "member": "string",
          "name": "Policy",
          "required": false,
          "type": "string",
          "value_allowed_null": false,
          "visibility": 2
        },
        {
          "disabled": false,
          "document": "策略描述",
          "example": "typeDesc",
          "member": "string",
          "name": "PolicyDesc",
          "required": false,
          "type": "string",
          "value_allowed_null": false,
          "visibility": 2
        }
      ],
      "usage": "out"
    }
  },
  "version": "1.0"
}